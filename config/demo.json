{
  // Пример настроек: судно 60 м, два азимутальных движителя в корме и два носовых туннельных.
  // Всё, что не указано, берётся по умолчанию. Пути и единицы: метры, ньютоны, градусы, секунды.
  "vessel": {
    "name": "Демонстрационное судно",
    "length": 60, "beam": 14, "draft": 4, "mass": 2200000,
    "frontalArea": 120, "lateralArea": 380, "cx": 0.7, "cy": 0.9, "cn": 0.12
  },
  "thrusters": [
    { "id": "AZ1",  "type": "azimuth", "x": -22, "y": -4, "maxForward": 180000, "maxReverse": 150000, "powerMaxKW": 700 },
    { "id": "AZ2",  "type": "azimuth", "x": -22, "y":  4, "maxForward": 180000, "maxReverse": 150000, "powerMaxKW": 700 },
    { "id": "BOW1", "type": "tunnel",  "x":  22, "y":  0, "maxForward": 100000, "maxReverse": 100000, "powerMaxKW": 400 },
    { "id": "BOW2", "type": "tunnel",  "x":  18, "y":  0, "maxForward": 100000, "maxReverse": 100000, "powerMaxKW": 400 }
  ],
  // Начало локальных координат: Финский залив западнее Кронштадта (открытая вода на карте КАР ONC-FinnischeSee10).
  "origin": { "lat": 60.0, "lon": 29.5 },
  "control": { "law": "pid" },

  // Имитатор судна и окружающей среды. Для работы с реальными датчиками поставьте "enabled": false и заполните "inputs".
  "sim": {
    "enabled": true, "speed": 1, "initialHeadingDeg": 10,
    "environment": { "windSpeed": 10, "windFromDeg": 60, "currentSpeed": 0.5, "currentToDeg": 200, "hs": 1.5, "tp": 7, "waveFromDeg": 60 }
  },

  // Пример входов для реальной работы (используются, когда имитатор выключен):
